{
    "openapi":  "3.1.0",
    "info":  {
                 "title":  "Portfolio Auth Service",
                 "version":  "0.0.1"
             },
    "servers":  [
                    {
                        "url":  "http://localhost:8000/api"
                    }
                ],
    "paths":  {
                  "/health":  {
                                  "get":  {
                                              "responses":  {
                                                                "200":  {
                                                                            "description":  "",
                                                                            "content":  {
                                                                                            "application/json":  {
                                                                                                                     "schema":  {
                                                                                                                                    "type":  "object",
                                                                                                                                    "properties":  {
                                                                                                                                                       "ok":  {
                                                                                                                                                                  "type":  "boolean"
                                                                                                                                                              },
                                                                                                                                                       "service":  {
                                                                                                                                                                       "type":  "string",
                                                                                                                                                                       "const":  "auth-service"
                                                                                                                                                                   },
                                                                                                                                                       "status":  {
                                                                                                                                                                      "type":  "string",
                                                                                                                                                                      "const":  "healthy"
                                                                                                                                                                  }
                                                                                                                                                   },
                                                                                                                                    "required":  [
                                                                                                                                                     "ok",
                                                                                                                                                     "service",
                                                                                                                                                     "status"
                                                                                                                                                 ]
                                                                                                                                }
                                                                                                                 }
                                                                                        }
                                                                        }
                                                            }
                                          }
                              },
                  "/v1/auth/register":  {
                                            "post":  {
                                                         "operationId":  "auth.register",
                                                         "description":  "Registra un nuevo usuario y devuelve un token de acceso.",
                                                         "summary":  "Registrar usuario",
                                                         "tags":  [
                                                                      "Auth"
                                                                  ],
                                                         "requestBody":  {
                                                                             "required":  true,
                                                                             "content":  {
                                                                                             "application/json":  {
                                                                                                                      "schema":  {
                                                                                                                                     "type":  "object",
                                                                                                                                     "properties":  {
                                                                                                                                                        "name":  {
                                                                                                                                                                     "type":  "string",
                                                                                                                                                                     "description":  "Nombre completo del usuario.",
                                                                                                                                                                     "examples":  [
                                                                                                                                                                                      "Ana García"
                                                                                                                                                                                  ]
                                                                                                                                                                 },
                                                                                                                                                        "email":  {
                                                                                                                                                                      "type":  "string",
                                                                                                                                                                      "format":  "email",
                                                                                                                                                                      "description":  "Correo electrónico único del usuario.",
                                                                                                                                                                      "examples":  [
                                                                                                                                                                                       "ana@ejemplo.com"
                                                                                                                                                                                   ]
                                                                                                                                                                  },
                                                                                                                                                        "password":  {
                                                                                                                                                                         "type":  "string",
                                                                                                                                                                         "format":  "password",
                                                                                                                                                                         "description":  "Contraseña segura con al menos 8 caracteres.",
                                                                                                                                                                         "examples":  [
                                                                                                                                                                                          "Secret123"
                                                                                                                                                                                      ]
                                                                                                                                                                     }
                                                                                                                                                    },
                                                                                                                                     "required":  [
                                                                                                                                                      "name",
                                                                                                                                                      "email",
                                                                                                                                                      "password"
                                                                                                                                                  ]
                                                                                                                                 }
                                                                                                                  }
                                                                                         }
                                                                         },
                                                         "responses":  {
                                                                           "201":  {
                                                                                       "description":  "Usuario registrado correctamente.",
                                                                                       "content":  {
                                                                                                       "application/json":  {
                                                                                                                                "schema":  {
                                                                                                                                               "type":  "object",
                                                                                                                                               "properties":  {
                                                                                                                                                                  "ok":  {
                                                                                                                                                                             "type":  "boolean"
                                                                                                                                                                         },
                                                                                                                                                                  "data":  {
                                                                                                                                                                               "type":  "object",
                                                                                                                                                                               "properties":  {
                                                                                                                                                                                                  "user":  {
                                                                                                                                                                                                               "type":  "object",
                                                                                                                                                                                                               "properties":  {
                                                                                                                                                                                                                                  "id":  {
                                                                                                                                                                                                                                             "type":  "integer"
                                                                                                                                                                                                                                         },
                                                                                                                                                                                                                                  "name":  {
                                                                                                                                                                                                                                               "type":  "string"
                                                                                                                                                                                                                                           },
                                                                                                                                                                                                                                  "email":  {
                                                                                                                                                                                                                                                "type":  "string"
                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                              },
                                                                                                                                                                                                               "required":  [
                                                                                                                                                                                                                                "id",
                                                                                                                                                                                                                                "name",
                                                                                                                                                                                                                                "email"
                                                                                                                                                                                                                            ]
                                                                                                                                                                                                           },
                                                                                                                                                                                                  "token":  {
                                                                                                                                                                                                               "type":  "string",
                                                                                                                                                                                                               "description":  "JWT Bearer token",
                                                                                                                                                                                                               "example":  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                                                                                                                                                                                            }
                                                                                                                                                                                              },
                                                                                                                                                                               "required":  [
                                                                                                                                                                                                "user",
                                                                                                                                                                                                "token"
                                                                                                                                                                                            ]
                                                                                                                                                                           }
                                                                                                                                                              },
                                                                                                                                               "required":  [
                                                                                                                                                                "ok",
                                                                                                                                                                "data"
                                                                                                                                                            ]
                                                                                                                                           }
                                                                                                                            }
                                                                                                   }
                                                                                   },
                                                                           "422":  {
                                                                                       "description":  "Los datos enviados no cumplen la validación.",
                                                                                       "content":  {
                                                                                                       "application/json":  {
                                                                                                                                "schema":  {
                                                                                                                                               "type":  "object",
                                                                                                                                               "properties":  {
                                                                                                                                                                  "message":  {
                                                                                                                                                                                  "type":  "string",
                                                                                                                                                                                  "description":  "Errors overview."
                                                                                                                                                                              },
                                                                                                                                                                  "errors":  {
                                                                                                                                                                                 "type":  "object",
                                                                                                                                                                                 "description":  "A detailed description of each field that failed validation.",
                                                                                                                                                                                 "additionalProperties":  {
                                                                                                                                                                                                              "type":  "array",
                                                                                                                                                                                                              "items":  {
                                                                                                                                                                                                                            "type":  "string"
                                                                                                                                                                                                                        }
                                                                                                                                                                                                          }
                                                                                                                                                                             }
                                                                                                                                                              },
                                                                                                                                               "required":  [
                                                                                                                                                                "message",
                                                                                                                                                                "errors"
                                                                                                                                                            ]
                                                                                                                                           }
                                                                                                                            }
                                                                                                   }
                                                                                   }
                                                                       }
                                                     }
                                        },
                  "/v1/auth/login":  {
                                         "post":  {
                                                      "operationId":  "auth.login",
                                                      "description":  "Autentica a un usuario y devuelve un token de acceso.",
                                                      "summary":  "Iniciar sesión",
                                                      "tags":  [
                                                                   "Auth"
                                                               ],
                                                      "requestBody":  {
                                                                          "required":  true,
                                                                          "content":  {
                                                                                          "application/json":  {
                                                                                                                   "schema":  {
                                                                                                                                  "type":  "object",
                                                                                                                                  "properties":  {
                                                                                                                                                     "email":  {
                                                                                                                                                                   "type":  "string",
                                                                                                                                                                   "format":  "email",
                                                                                                                                                                   "description":  "Correo electrónico registrado.",
                                                                                                                                                                   "examples":  [
                                                                                                                                                                                    "ana@ejemplo.com"
                                                                                                                                                                                ]
                                                                                                                                                               },
                                                                                                                                                     "password":  {
                                                                                                                                                                      "type":  "string",
                                                                                                                                                                      "format":  "password",
                                                                                                                                                                      "description":  "Contraseña del usuario.",
                                                                                                                                                                      "examples":  [
                                                                                                                                                                                       "Secret123"
                                                                                                                                                                                   ]
                                                                                                                                                                  }
                                                                                                                                                 },
                                                                                                                                  "required":  [
                                                                                                                                                   "email",
                                                                                                                                                   "password"
                                                                                                                                               ]
                                                                                                                              }
                                                                                                               }
                                                                                      }
                                                                      },
                                                      "responses":  {
                                                                        "200":  {
                                                                                    "description":  "Sesión iniciada correctamente.",
                                                                                    "content":  {
                                                                                                    "application/json":  {
                                                                                                                             "schema":  {
                                                                                                                                            "type":  "object",
                                                                                                                                            "properties":  {
                                                                                                                                                               "ok":  {
                                                                                                                                                                          "type":  "boolean"
                                                                                                                                                                      },
                                                                                                                                                               "data":  {
                                                                                                                                                                            "type":  "object",
                                                                                                                                                                            "properties":  {
                                                                                                                                                                                               "user":  {
                                                                                                                                                                                                            "type":  "object",
                                                                                                                                                                                                            "properties":  {
                                                                                                                                                                                                                               "id":  {
                                                                                                                                                                                                                                          "type":  "integer"
                                                                                                                                                                                                                                      },
                                                                                                                                                                                                                               "name":  {
                                                                                                                                                                                                                                            "type":  "string"
                                                                                                                                                                                                                                        },
                                                                                                                                                                                                                               "email":  {
                                                                                                                                                                                                                                             "type":  "string"
                                                                                                                                                                                                                                         }
                                                                                                                                                                                                                           },
                                                                                                                                                                                                            "required":  [
                                                                                                                                                                                                                             "id",
                                                                                                                                                                                                                             "name",
                                                                                                                                                                                                                             "email"
                                                                                                                                                                                                                         ]
                                                                                                                                                                                                        },
                                                                                                                                                                                               "token":  {
                                                                                                                                                                                                        "type":  "string",
                                                                                                                                                                                                        "description":  "JWT Bearer token",
                                                                                                                                                                                                        "example":  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                                                                                                                                                                                         }
                                                                                                                                                                                           },
                                                                                                                                                                            "required":  [
                                                                                                                                                                                             "user",
                                                                                                                                                                                             "token"
                                                                                                                                                                                         ]
                                                                                                                                                                        }
                                                                                                                                                           },
                                                                                                                                            "required":  [
                                                                                                                                                             "ok",
                                                                                                                                                             "data"
                                                                                                                                                         ]
                                                                                                                                        }
                                                                                                                         }
                                                                                                }
                                                                                },
                                                                        "422":  {
                                                                                    "description":  "Credenciales inválidas.",
                                                                                    "content":  {
                                                                                                    "application/json":  {
                                                                                                                             "schema":  {
                                                                                                                                            "type":  "object",
                                                                                                                                            "properties":  {
                                                                                                                                                               "message":  {
                                                                                                                                                                               "type":  "string",
                                                                                                                                                                               "description":  "Errors overview."
                                                                                                                                                                           },
                                                                                                                                                               "errors":  {
                                                                                                                                                                              "type":  "object",
                                                                                                                                                                              "description":  "A detailed description of each field that failed validation.",
                                                                                                                                                                              "additionalProperties":  {
                                                                                                                                                                                                           "type":  "array",
                                                                                                                                                                                                           "items":  {
                                                                                                                                                                                                                         "type":  "string"
                                                                                                                                                                                                                     }
                                                                                                                                                                                                       }
                                                                                                                                                                          }
                                                                                                                                                           },
                                                                                                                                            "required":  [
                                                                                                                                                             "message",
                                                                                                                                                             "errors"
                                                                                                                                                         ]
                                                                                                                                        }
                                                                                                                         }
                                                                                                }
                                                                                }
                                                                    }
                                                  }
                                     },
                  "components":  {
                                     "securitySchemes":  {
                                                             "BearerAuth":  {
                                                                                "type":  "http",
                                                                                "scheme":  "bearer",
                                                                                "bearerFormat":  "JWT",
                                                                                "description":  "JWT generated by /v1/auth/login or /v1/auth/register"
                                                                            }
                                                         }
                                 }
              }
}
